# Copy to .env; never commit keys. Run all commands from v2/.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-6-luna
LLM_API_KEY=
LLM_INPUT_USD_PER_MTOK=0.10
LLM_OUTPUT_USD_PER_MTOK=0.50
LLM_MAX_OUTPUT_TOKENS=512

# Direct TypeSafe wire format, NOT ordinary chat completions.
JEV_BASE_URL=https://api.typesafe.ai/v1
JEV_MODEL=jev-1.14.0
JEV_API_KEY=
JEV_INPUT_USD_PER_MTOK=0.042
DECISION_MODE=jev
# coordinated separates game actions from asynchronous plan review.
JEV_ARGUMENT_CONTRACT=legacy
# Optional binary withdrawal before argument binding (additional API calls)
JEV_WITHDRAWAL_MODE=joint
MIN_CONFIDENCE=0.55

MC_HOST=127.0.0.1
MC_PORT=25565
MC_VERSION=1.21.1
MC_AUTH=offline
BOT_NAMES=Alice,Bob
FOLLOW_PLAYER=
RUN_SECONDS=300
DECISION_INTERVAL_MS=1000
PLAN_INTERVAL_MS=45000
ACTION_TIMEOUT_MS=20000
API_TIMEOUT_MS=120000
MAX_API_CALLS=500
# Estimated stop threshold, not a guaranteed provider billing cap; in-flight calls may overshoot.
MAX_ESTIMATED_USD=2
LONG_PLAN_INTERVAL_MS=180000
REFLECTION_INTERVAL_MS=60000
SOCIAL_INTERVAL_MS=30000
JEV_TIMEOUT_MS=5000
